---
interface Position {
  title: string;
  period: string;
  points: string[];
  current?: boolean;
}

interface Role {
  company: string;
  positions: Position[];
}

const roles: Role[] = [
  {
    company: 'Skyworks Solutions',
    positions: [
      {
        title: 'Software Engineer',
        period: 'Jun 2026 – Present',
        points: [
          'Building internal tooling for product engineering (MSB) & assisting in management of company websites.',
        ],
        current: true,
      },
      {
        title: 'Digital Analytics & Content Operations Co-op',
        period: 'Jan 2026 – Jun 2026',
        points: [
          'Built a privacy-first analytics pipeline that generates 0-100 Content Performance Score (CPS) for Skyworks web pages using cookie-lite engagement metrics (scroll depth, dwell time, bounce, exit rate).',
        ],
      },
    ],
  },
  {
    company: 'Industrial Technology Research Institute (ITRI)',
    positions: [
      {
        title: 'Data Analyst Intern',
        period: 'Jul 2025 – Aug 2025',
        points: [
          'Designed an NLP pipeline for large-scale text data, including data cleaning, feature extraction, and structured signal generation.',
        ],
      },
    ],
  },
  {
    company: 'The Floc App',
    positions: [
      {
        title: 'Data Science Intern',
        period: 'Jul 2025 – Aug 2025',
        points: [
          'Assisted in building iOS-based social matchmaking app for Gen Z users.',
        ],
      },
    ],
  },
  {
    company: 'Maxzone Auto Parts Corporation',
    positions: [
      {
        title: 'Data Engineering Intern',
        period: 'Jun 2024 – Sep 2024',
        points: [
          'Automated reports and supported data operations across departments.',
        ],
      },
    ],
  },
  {
    company: 'Code Ninjas',
    positions: [
      {
        title: 'Coding Instructor',
        period: 'Jun 2021 – Jul 2021',
        points: [
          'Taught coding fundamentals and led a stop-motion animation workshop for students.',
        ],
      },
    ],
  },
];
---

<section id="experience" class="max-w-2xl mx-auto px-6 py-16">
  <h2 class="text-sm font-medium uppercase tracking-widest text-muted mb-10">
    Experience
  </h2>
  <div class="flex flex-col gap-8">
    {roles.map(role => (
      <div class="group border-l-2 border-accent-dim pl-4">
        <h3 class="text-base font-semibold text-text">{role.company}</h3>
        <div class={role.positions.length > 1 ? 'mt-3 flex flex-col gap-4' : 'mt-1.5 flex flex-col gap-4'}>
          {role.positions.map(position => (
            <div class={role.positions.length > 1 ? `border-l pl-4 ${position.current ? 'border-green-500' : 'border-border-hover'}` : ''}>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <p class="text-sm font-semibold text-text">{position.title}</p>
                <span class="text-xs text-muted shrink-0">{position.period}</span>
              </div>
              {position.points.length === 1 ? (
                <p class="mt-1.5 text-sm text-text-secondary leading-relaxed">{position.points[0]}</p>
              ) : position.points.length > 1 ? (
                <ul class="mt-1.5 flex flex-col gap-1.5">
                  {position.points.map(point => (
                    <li class="text-sm text-text-secondary leading-relaxed pl-4 relative before:content-['–'] before:absolute before:left-0 before:text-border-hover">
                      {point}
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
